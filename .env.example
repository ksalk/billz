# ISO 4217 currency code used to format every amount. Required.
BILLZ_CURRENCY=PLN

# Interface that publishes the port. Keep 127.0.0.1 for this machine only;
# use 0.0.0.0 to reach Billz from other devices on a trusted LAN.
BILLZ_BIND=127.0.0.1

# Hostnames accepted by Compose deployments. Add the LAN hostname or IP when
# exposing Billz beyond localhost; this blocks DNS-rebinding requests using
# foreign Host values. Direct .NET runs use the AllowedHosts config key instead.
BILLZ_ALLOWED_HOSTS=localhost;127.0.0.1;[::1]

# Host port exposed by Docker Compose.
BILLZ_PORT=8080

# Image name/tag used by Docker Compose.
BILLZ_IMAGE=billz:local

# Docker volume that holds the SQLite database.
BILLZ_VOLUME_NAME=billz-data
